# Static-host header rules. Read natively by Netlify and Cloudflare Pages.
# Vercel uses vercel.json instead (kept in sync manually).
# Other hosts ignore this file — see README "Deploying" for nginx/Apache equivalents.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-DNS-Prefetch-Control: on
  # The site ships no JS of its own; it needs Google Fonts CSS + font files,
  # a Google Maps iframe on /contact once mapEmbedUrl is set, and an inline
  # JSON-LD block for local SEO (hence script-src 'unsafe-inline').
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com https://maps.google.com; script-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; frame-ancestors 'self'; manifest-src 'self'

# Fingerprinted assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon-32x32.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon-16x16.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
