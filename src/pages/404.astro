---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Page Not Found"
  description="That page does not exist. Browse our product categories or get in touch instead."
  indexable={false}
>
  <section class="notfound">
    <div class="container notfound__inner">
      <span class="notfound__code grad-text" aria-hidden="true">404</span>
      <h1>We could not find that page</h1>
      <p class="lead">
        The link may be out of date, or the address might have a typo. Everything on the site is one click
        away below.
      </p>

      <div class="actions actions--center">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--glass" href="/contact">Contact us</a>
      </div>

      <nav class="notfound__links" aria-label="All pages">
        <h2 class="notfound__links-title">All pages</h2>
        <ul>
          {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 6.5rem);
  }

  .notfound::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -18rem;
    left: 50%;
    translate: -50% 0;
    width: 44rem;
    height: 44rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.26), transparent 62%);
    pointer-events: none;
  }

  .notfound__inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .notfound__code {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    margin-bottom: 0.75rem;
  }

  .notfound .lead {
    margin-inline: auto;
  }

  .notfound__links {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .notfound__links-title {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .notfound__links ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  .notfound__links a {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-dim);
    font-size: 0.92rem;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .notfound__links a:hover {
    background: var(--surface-hover);
    border-color: var(--line-strong);
    color: var(--text);
  }
</style>
