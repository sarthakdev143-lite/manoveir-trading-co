---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Page Not Found"
  description="That page does not exist. Browse our product categories or get in touch instead."
  indexable={false}
>
  <section class="section notfound">
    <div class="container notfound__inner">
      <span class="notfound__code" aria-hidden="true">404</span>
      <h1>We could not find that page</h1>
      <p class="lead">
        The link may be out of date, or the address might have a typo. Everything on the site is one click
        away below.
      </p>

      <div class="actions">
        <a class="btn btn--primary" href="/">
          Back to home
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--outline" href="/contact">Contact us</a>
      </div>

      <nav class="notfound__links" aria-label="All pages">
        <h2 class="notfound__links-title">All pages</h2>
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href}>
                  <Icon name="arrowRight" />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .notfound__inner {
    max-width: 38rem;
  }

  .notfound__code {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--amber);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .notfound__links {
    margin-top: 2.75rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }

  .notfound__links-title {
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .notfound__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    list-style: none;
    padding: 0;
  }

  .notfound__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .notfound__links a:hover {
    color: var(--amber);
  }

  .notfound__links :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--amber);
  }
</style>
