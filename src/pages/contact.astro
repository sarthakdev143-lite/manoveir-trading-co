---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Icon from "../components/Icon.astro";
import { site, isPlaceholder } from "../config/site";

const { email } = site.contact;

const hasEmail = !isPlaceholder(email);
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} — email enquiries about staffing, delivery and engagements.`}
>
  <section class="masthead">
    <div class="container masthead__inner">
      <div>
        <span class="eyebrow">Contact</span>
        <h1>Get in touch</h1>
        <p class="lead">
          Send a short brief — role, stack, timeline — and we will come back with people who fit. The form
          opens your own email app, so nothing is submitted through this website.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="panel contact__details">
        <span class="eyebrow">How to reach us</span>
        <h2 class="contact__title">Get in touch</h2>
        <ContactBlock />
      </div>

      <div class="panel contact__form-panel">
        <span class="eyebrow">Send an enquiry</span>
        <h2 class="contact__title">Ask about a role, a team, or an engagement</h2>
        <p class="contact__intro">
          This form opens your own email app with the message ready to send — nothing is submitted through
          this website.
        </p>

        <form
          class="form"
          action={hasEmail ? `mailto:${email}` : undefined}
          method="post"
          enctype="text/plain"
        >
          <div class="form__row">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="Name" type="text" autocomplete="name" required disabled={!hasEmail} />
            </div>
            <div class="field">
              <label for="phone">Phone number</label>
              <input id="phone" name="Phone" type="tel" autocomplete="tel" required disabled={!hasEmail} />
            </div>
          </div>

          <div class="field">
            <label for="message">Your message</label>
            <textarea
              id="message"
              name="Message"
              rows="5"
              required
              disabled={!hasEmail}
              placeholder="Tell us about the role, stack, timeline or scope you have in mind."
            ></textarea>
          </div>

          <button class="btn btn--primary form__submit" type="submit" disabled={!hasEmail}>
            Open email &amp; send
            <Icon name="arrowRight" />
          </button>

          {
            !hasEmail && (
              <p class="form__note">
                Our enquiry inbox is being set up. Until it is live, please reach out once it is available and we
                will respond.
              </p>
            )
          }
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    align-items: start;
  }

  .contact > * {
    min-width: 0;
  }

  @media (min-width: 62rem) {
    .contact {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  .contact__title {
    margin-bottom: 1.25rem;
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
  }

  .contact__intro {
    margin-bottom: 1.5rem;
    color: var(--text-dim);
    font-size: 0.96rem;
  }

  .contact__tel {
    color: var(--amber);
  }

  .contact__tel:hover {
    color: var(--amber-light);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form__row {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .form__row > * {
    min-width: 0;
  }

  .form__submit {
    align-self: flex-start;
  }

  .form__submit:disabled {
    background: var(--surface-2);
    border-color: var(--line);
    color: var(--text-faint);
    cursor: not-allowed;
  }

  .form__note {
    color: var(--text-faint);
    font-size: 0.88rem;
  }
</style>
