---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { site, isPlaceholder, displayValue } from "../config/site";

const { email, phone, phoneDisplay, mapEmbedUrl } = site.contact;

const hasEmail = !isPlaceholder(email);
const hasPhone = !isPlaceholder(phone);
const hasMapEmbed = !isPlaceholder(mapEmbedUrl);
---

<BaseLayout
  title="Contact & Location"
  description={`Visit ${site.name} in person — address, phone, email, opening hours and directions.`}
>
  <section class="masthead">
    <div class="container masthead__inner">
      <div>
        <span class="eyebrow">Contact &amp; location</span>
        <h1>Find us, call us, or just drop by</h1>
        <p class="lead">
          We are a walk-in shop, so the best way to reach us is in person or over the phone during opening
          hours.
        </p>
      </div>

      <dl class="meta">
        <div>
          <dt>Best contact</dt>
          <dd>In person</dd>
        </div>
        <div>
          <dt>Then</dt>
          <dd>By phone</dd>
        </div>
        <div>
          <dt>Online orders</dt>
          <dd>Not offered</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div>
        <span class="eyebrow">01 / Shop details</span>
        <h2 class="contact__title">Where to find us</h2>
        <ContactBlock />
      </div>

      <div class="contact__map">
        <span class="contact__map-tag">Fig. 02 — Location</span>
        {
          hasMapEmbed ? (
            <iframe
              src={mapEmbedUrl}
              title={`Map showing the location of ${site.name}`}
              width="100%"
              height="100%"
              style="border:0; min-height: 24rem;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          ) : (
            <div class="map-placeholder">
              <div class="map-placeholder__plate">
                <span class="map-placeholder__icon" aria-hidden="true">🗺️</span>
                <p class="map-placeholder__title">Map placeholder</p>
                <p class="map-placeholder__hint">
                  Replace <code>mapEmbedUrl</code> in <code>src/config/site.ts</code> with a Google Maps embed
                  URL and this box becomes a live map.
                </p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Enquiry form -->
  <section class="section section--paper2">
    <div class="container">
      <div class="form-wrap">
        <div class="section-head">
          <span class="eyebrow">02 / Send an enquiry</span>
          <h2>Ask us about stock, prices or bulk orders</h2>
          <p class="lead">
            This form opens your own email app with the message pre-filled — nothing is sent through this
            website. If you would rather talk to someone,{" "}
            {
              hasPhone ? (
                <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}>call us on {displayValue(phoneDisplay)}</a>
              ) : (
                <span>call us on <span class="todo">{displayValue(phoneDisplay)}</span></span>
              )
            }.
          </p>
        </div>

        {
          !hasEmail && (
            <p class="form-notice">
              <strong>Form inactive:</strong> add a real address to <code>contact.email</code> in
              <code>src/config/site.ts</code> to enable it.
            </p>
          )
        }

        <form
          class="form panel"
          action={hasEmail ? `mailto:${email}` : undefined}
          method="post"
          enctype="text/plain"
        >
          <div class="form__row">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="Name" type="text" autocomplete="name" required disabled={!hasEmail} />
            </div>
            <div class="field">
              <label for="phone">Phone number</label>
              <input id="phone" name="Phone" type="tel" autocomplete="tel" required disabled={!hasEmail} />
            </div>
          </div>

          <div class="field">
            <label for="message">Your message</label>
            <textarea
              id="message"
              name="Message"
              rows="5"
              required
              disabled={!hasEmail}
              placeholder="Tell us what you are looking for — item, quantity, or a question about stock."
            ></textarea>
          </div>

          <button class="btn btn--primary" type="submit" disabled={!hasEmail}>Open email &amp; send</button>
          <p class="form__note">Or call us directly during opening hours — we usually pick up right away.</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 58rem) {
    .contact {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  .contact__title {
    margin-bottom: 1.75rem;
  }

  .contact__map {
    position: relative;
    padding-top: 2rem;
    background: var(--surface);
    border: var(--line);
    box-shadow: var(--hard);
  }

  .contact__map-tag {
    position: absolute;
    top: -1px;
    left: -1px;
    padding: 0.3rem 0.6rem;
    background: var(--ink);
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .map-placeholder {
    display: grid;
    place-items: center;
    min-height: 22rem;
    padding: 1.5rem;
    background: repeating-linear-gradient(
        45deg,
        rgba(19, 21, 20, 0.07) 0 2px,
        transparent 2px 9px
      ),
      var(--surface);
  }

  .map-placeholder__plate {
    max-width: 24rem;
    padding: 1.4rem 1.6rem;
    background: var(--surface);
    border: var(--line);
    text-align: center;
  }

  .map-placeholder__icon {
    display: block;
    font-size: 2.25rem;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .map-placeholder__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--ink);
  }

  .map-placeholder__hint {
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .form-wrap {
    max-width: 48rem;
  }

  .form-notice {
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.5rem;
    background: rgba(226, 78, 27, 0.1);
    border: 1px dashed var(--clay);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--clay-ink);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form__row {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .field label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .field input,
  .field textarea {
    padding: 0.8rem 0.9rem;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 0;
    font-size: 0.98rem;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    background: var(--surface);
    outline: 3px solid var(--clay);
    outline-offset: 0;
  }

  .field input:disabled,
  .field textarea:disabled {
    background: var(--paper-2);
    border-color: rgba(19, 21, 20, 0.3);
    color: var(--muted);
    cursor: not-allowed;
  }

  .form button[type="submit"] {
    align-self: flex-start;
  }

  .form button[type="submit"]:disabled {
    background: var(--paper-2);
    border-color: rgba(19, 21, 20, 0.3);
    color: var(--muted);
    box-shadow: none;
    transform: none;
    cursor: not-allowed;
  }

  .form__note {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.7;
    color: var(--muted);
  }
</style>
