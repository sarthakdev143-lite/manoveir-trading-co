---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import Icon from "../components/Icon.astro";
import ShelfRack from "../components/illustrations/ShelfRack.astro";
import { site } from "../config/site";

const notes = [
  {
    title: "Restocked regularly",
    desc: "Fast-moving staples are replenished on a routine cycle, and we rotate stock so what you pick up is fresh and well within date.",
    icon: "basket",
  },
  {
    title: "Brands and sizes vary",
    desc: "We carry a practical mix of brands and pack sizes rather than a single option, so there is usually something that fits your budget.",
    icon: "tag",
  },
  {
    title: "Ask and we will source it",
    desc: "If something you need is not on the shelf, tell us. We can often bring it in on the next stock run.",
    icon: "people",
  },
];
---

<BaseLayout
  title="Products & Categories"
  description={`Explore the ${site.categories.length} product categories stocked at ${site.name} — groceries, household essentials, personal care, beverages, stationery and festive goods.`}
>
  <section class="masthead">
    <div class="container masthead__inner masthead__inner--split">
      <div>
        <span class="eyebrow">Products</span>
        <h1>What you will find on our shelves</h1>
        <p class="lead">
          {site.categories.length} categories covering the everyday essentials — plus the seasonal extras that
          only matter a few weeks a year but matter a lot when they do.
        </p>
      </div>

      <figure class="masthead__figure">
        <ShelfRack />
      </figure>
    </div>
  </section>

  <!-- Full category list -->
  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {site.categories.map((category) => <CategoryCard {...category} />)}
      </div>
    </div>
  </section>

  <!-- Stock notes -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Good to know</span>
        <h2>How we handle stock</h2>
        <p class="lead">What is on the shelf changes week to week. Here is how we keep it moving.</p>
      </div>

      <div class="grid grid--3">
        {
          notes.map((note) => (
            <article class="card">
              <span class="icon-tile">
                <Icon name={note.icon as any} />
              </span>
              <h3>{note.title}</h3>
              <p>{note.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container section-head" style="margin-bottom:0">
      <h2>Looking for something specific?</h2>
      <p class="lead">Visit us or get in touch — the fastest way to check availability is to ask.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/contact">
          Contact us
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--outline" href="/about">About our shop</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead__figure {
    margin: 0;
    padding: clamp(0.65rem, 1.2vw, 1rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .masthead__figure :global(.shelfrack) {
    border-radius: var(--radius);
    background: var(--bg);
  }
</style>
