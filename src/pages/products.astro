---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Products & Categories"
  description={`Explore the ${site.categories.length} product categories stocked at ${site.name} — groceries, household essentials, personal care, beverages, stationery and festive goods.`}
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Products</span>
      <h1>What you will find on our shelves</h1>
      <p class="lead">
        {site.categories.length} categories covering the everyday essentials — plus the seasonal extras that
        only matter a few weeks a year but matter a lot when they do.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {site.categories.map((category) => <CategoryCard {...category} />)}
      </div>
    </div>
  </section>

  <!-- Stock note -->
  <section class="section section--cream">
    <div class="container notes">
      <div class="section-head" style="margin-bottom:1.5rem">
        <span class="eyebrow">Good to Know</span>
        <h2>How we handle stock</h2>
      </div>
      <div class="grid grid--3">
        <div class="note">
          <h3>Restocked regularly</h3>
          <p>
            Fast-moving staples are replenished on a routine cycle, and we rotate stock so what you pick up is
            fresh and well within date.
          </p>
        </div>
        <div class="note">
          <h3>Brands and sizes vary</h3>
          <p>
            We carry a practical mix of brands and pack sizes rather than a single option, so there is usually
            something that fits your budget.
          </p>
        </div>
        <div class="note">
          <h3>Ask and we will source it</h3>
          <p>
            If something you need is not on the shelf, tell us. We can often bring it in on the next stock run.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container section-head section-head--center" style="margin-bottom:0">
      <h2>Looking for something specific?</h2>
      <p class="lead">
        Visit us or get in touch — the fastest way to check availability is to ask.
      </p>
      <div class="actions actions--center">
        <a class="btn btn--primary" href="/contact">Contact Us</a>
        <a class="btn btn--outline" href="/about">About Our Shop</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    background: linear-gradient(180deg, var(--cream-100), var(--cream-50));
    padding-block: clamp(2.75rem, 6vw, 4.25rem);
    border-bottom: var(--border);
  }

  .page-head .lead {
    max-width: 44rem;
  }

  .note h3 {
    margin-bottom: 0.5rem;
    padding-top: 0.9rem;
    border-top: 3px solid var(--gold-500);
  }

  .note p {
    color: var(--slate-600);
    font-size: 0.96rem;
  }

  .actions--center {
    justify-content: center;
  }
</style>
