---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import { site } from "../config/site";

const notes = [
  {
    title: "Restocked regularly",
    desc: "Fast-moving staples are replenished on a routine cycle, and we rotate stock so what you pick up is fresh and well within date.",
  },
  {
    title: "Brands and sizes vary",
    desc: "We carry a practical mix of brands and pack sizes rather than a single option, so there is usually something that fits your budget.",
  },
  {
    title: "Ask and we will source it",
    desc: "If something you need is not on the shelf, tell us. We can often bring it in on the next stock run.",
  },
];
---

<BaseLayout
  title="Products & Categories"
  description={`Explore the ${site.categories.length} product categories stocked at ${site.name} — groceries, household essentials, personal care, beverages, stationery and festive goods.`}
>
  <section class="masthead">
    <div class="container masthead__inner">
      <div>
        <span class="eyebrow">Products</span>
        <h1>What you will find on our shelves</h1>
        <p class="lead">
          {site.categories.length} categories covering the everyday essentials — plus the seasonal extras that
          only matter a few weeks a year but matter a lot when they do.
        </p>
      </div>

      <dl class="meta">
        <div>
          <dt>Categories</dt>
          <dd>{site.categories.length}</dd>
        </div>
        <div>
          <dt>Items stocked</dt>
          <dd>1000+</dd>
        </div>
        <div>
          <dt>Availability</dt>
          <dd>In shop</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Full category matrix -->
  <section class="section">
    <div class="container">
      <div class="matrix matrix--3">
        {site.categories.map((category, i) => <CategoryCard {...category} index={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- Stock note -->
  <section class="section section--paper2">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">Good to know</span>
          <h2>How we handle stock</h2>
        </div>
        <p class="lead">
          What is on the shelf changes week to week. Here is how we keep it moving.
        </p>
      </div>

      <div class="matrix matrix--3">
        {
          notes.map((note, i) => (
            <article class="cell">
              <span class="cell__index">{String(i + 1).padStart(2, "0")}</span>
              <h3>{note.title}</h3>
              <p>{note.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container cta">
      <h2>Looking for something specific?</h2>
      <p class="lead">Visit us or get in touch — the fastest way to check availability is to ask.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/contact">Contact us</a>
        <a class="btn btn--outline" href="/about">About our shop</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cta {
    max-width: 44rem;
  }
</style>
