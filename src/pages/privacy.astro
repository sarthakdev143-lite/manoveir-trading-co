---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, isPlaceholder } from "../config/site";

const { email } = site.contact;
const hasEmail = !isPlaceholder(email);
---

<BaseLayout
  title="Privacy Policy"
  description={`Privacy policy for ${site.name} — how we handle information when you visit our site or contact us.`}
>
  <section class="masthead">
    <div class="container masthead__inner">
      <div>
        <span class="eyebrow">Legal</span>
        <h1>Privacy Policy</h1>
        <p class="lead">
          This site is intentionally simple: it does not collect, profile or sell personal information.
        </p>
        <p class="masthead__meta">Last updated: 3 September 2026</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose-legal">
        <h2>1. No tracking, no cookies</h2>
        <p>
          This website sets no cookies. It uses no analytics, no advertising trackers and no third-party
          scripts, and it stores nothing in your browser. Your visit is not profiled, and we cannot tell who
          you are from browsing these pages.
        </p>

        <h2>2. Information you share when you contact us</h2>
        <p>
          The enquiry form on our <a href="/contact">contact page</a> does not send anything through this
          website, and there is no server here to store it. Submitting it opens your own email application
          with the message ready to send{
            hasEmail ? " to us" : ", once our inbox is live"
          }. Whatever you choose to include — your name, phone number and message — travels through your own
          email provider, and we use it only to answer you.
        </p>
        <p>
          Any information you share is used only to reply to your enquiry, not to build a marketing list.
        </p>

        <h2>3. What we do not do</h2>
        <ul>
          <li>We do not sell, rent or share personal data.</li>
          <li>We do not run a newsletter or send automated marketing.</li>
          <li>We do not store enquiries on any server behind this website.</li>
          <li>We do not use fingerprinting, session replay or cross-site tracking.</li>
        </ul>

        <h2>4. The one external request</h2>
        <p>
          The site loads its two typefaces from Google Fonts, which means your browser fetches those font
          files from Google's servers and Google sees the request. Nothing else on these pages is loaded from
          a third party — the illustrations, icons and styles are all served from this site.
        </p>

        <h2>5. Your rights</h2>
        <p>
          If you have shared information with us by email or phone and want it corrected or deleted, ask us
          via our <a href="/contact">contact page</a> and we will handle it promptly.
        </p>

        <h2>6. Changes to this policy</h2>
        <p>
          If we ever add analytics — even privacy-friendly, cookie-less visit counts — or start handling
          enquiries on a server, we will update this page to say what is collected and why before that goes
          live.
        </p>

        <div class="legal-cta">
          <a class="btn btn--primary" href="/contact">Contact us</a>
          <a class="btn btn--outline" href="/">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead__meta {
    margin-top: 1rem;
    color: var(--text-faint);
    font-size: 0.88rem;
  }

  .prose-legal {
    max-width: 44rem;
  }

  .prose-legal h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.65rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .prose-legal h2:first-child {
    margin-top: 0;
  }

  .prose-legal p,
  .prose-legal li {
    color: var(--text-dim);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .prose-legal p + p {
    margin-top: 1rem;
  }

  .prose-legal ul {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .prose-legal li {
    position: relative;
    padding-left: 1.15rem;
  }

  .prose-legal li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--amber);
  }

  .legal-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
</style>
