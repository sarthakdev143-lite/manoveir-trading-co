---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CategoryCard from "../components/CategoryCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import ShelfRack from "../components/illustrations/ShelfRack.astro";
import { site } from "../config/site";

const featured = site.categories.slice(0, 4);
---

<BaseLayout title={site.name}>
  <Hero />

  <!-- Featured categories -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we stock</span>
        <h2>Everyday essentials, all under one roof</h2>
        <p class="lead">
          From kitchen staples to festive gifting, we keep the goods local households reach for most —
          restocked regularly and priced fairly.
        </p>
      </div>

      <div class="grid grid--4">
        {featured.map((category) => <CategoryCard {...category} examples={[]} />)}
      </div>

      <div class="actions">
        <a class="btn btn--outline" href="/products">
          View all {site.categories.length} categories
          <Icon name="arrowRight" />
        </a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why choose us</span>
        <h2>A shop built on service, not scale</h2>
        <p class="lead">
          We are a neighbourhood retailer, and that shapes how we buy, price and stock everything on our
          shelves.
        </p>
      </div>

      <div class="grid grid--4">
        {site.whyChooseUs.map((feature) => <FeatureCard {...feature} />)}
      </div>
    </div>
  </section>

  <!-- Visit us -->
  <section class="section section--alt">
    <div class="container visit">
      <div class="visit__copy">
        <span class="eyebrow">Visit our shop</span>
        <h2>Come see us in person</h2>
        <p class="lead">
          No online cart and no delivery windows — walk in, pick what you need, and ask us anything. If
          something is not on the shelf, tell us and we will try to bring it in on the next stock run.
        </p>

        <div class="actions">
          <a class="btn btn--primary" href="/contact">
            Get in touch
            <Icon name="arrowRight" />
          </a>
          <a class="btn btn--outline" href="/about">About our shop</a>
        </div>
      </div>

      <figure class="visit__figure">
        <ShelfRack />
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .visit {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
  }

  .visit > * {
    min-width: 0;
  }

  @media (min-width: 58rem) {
    .visit {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .visit__figure {
    margin: 0;
    padding: clamp(0.75rem, 1.5vw, 1.15rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .visit__figure :global(.shelfrack) {
    border-radius: var(--radius);
    background: var(--bg);
  }
</style>
