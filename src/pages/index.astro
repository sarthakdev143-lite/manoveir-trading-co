---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import { site } from "../config/site";

const { itServices } = site;
---
<BaseLayout title={site.name}>
  <Hero />

  <!-- Services -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Four ways we work with client teams</h2>
        <p class="lead">
          Staff augmentation is the core of it, with the delivery, advisory and support work built around it.
        </p>
      </div>

      <div class="grid grid--4">
        {
          itServices.services.map((service) => (
            <article class="card">
              <span class="icon-tile">
                <Icon name={service.icon as any} />
              </span>
              <h3>{service.title}</h3>
              <p>{service.desc}</p>
            </article>
          ))
        }
      </div>

      <div class="actions">
        <a class="btn btn--outline" href="/it-services">
          See how engagements work
          <Icon name="arrowRight" />
        </a>
      </div>
    </div>
  </section>

  <!-- Why work with us -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why work with us</span>
        <h2>A staffing partner built on fit, not volume</h2>
        <p class="lead">
          We are a small practice, and that shapes how we match people, plan engagements and stay involved.
        </p>
      </div>

      <div class="grid grid--4">
        {site.whyChooseUs.map((feature) => <FeatureCard {...feature} />)}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>From first conversation to a working engagement</h2>
      </div>

      <div class="process">
        {
          itServices.process.map((step, i) => (
            <div class="process__step">
              <span class="process__index">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section">
    <div class="container section-head" style="margin-bottom:0">
      <h2>Looking to bring in IT staff or a small dev team?</h2>
      <p class="lead">
        Send us a note with the role, skills and rough timeline, and we will come back with people who fit.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/contact">
          Contact us
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--outline" href="/about">About us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .process {
    display: grid;
    gap: 1.5rem;
  }

  .process > * {
    min-width: 0;
  }

  @media (min-width: 58rem) {
    .process {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process__step {
    padding: clamp(1.4rem, 2vw, 1.75rem) clamp(1.25rem, 2vw, 1.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .process__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 1rem;
    background: var(--amber-soft);
    border: 1px solid var(--amber-edge);
    border-radius: 999px;
    color: var(--amber);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }

  .process__step h3 {
    margin-bottom: 0.4rem;
  }

  .process__step p {
    color: var(--text-dim);
    font-size: 0.92rem;
  }
</style>
