---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CategoryCard from "../components/CategoryCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import ShelfRack from "../components/illustrations/ShelfRack.astro";
import { site } from "../config/site";

const featured = site.categories.slice(0, 4);
const { itServices } = site;
---

<BaseLayout title={site.name}>
  <Hero />

  <!-- Featured categories -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we stock</span>
        <h2>Everyday essentials, all under one roof</h2>
        <p class="lead">
          From kitchen staples to festive gifting, we keep the goods local households reach for most —
          restocked regularly and priced fairly.
        </p>
      </div>

      <div class="grid grid--4">
        {featured.map((category) => <CategoryCard {...category} examples={[]} />)}
      </div>

      <div class="actions">
        <a class="btn btn--outline" href="/products">
          View all {site.categories.length} categories
          <Icon name="arrowRight" />
        </a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why choose us</span>
        <h2>A shop built on service, not scale</h2>
        <p class="lead">
          We are a neighbourhood retailer, and that shapes how we buy, price and stock everything on our
          shelves.
        </p>
      </div>

      <div class="grid grid--4">
        {site.whyChooseUs.map((feature) => <FeatureCard {...feature} />)}
      </div>
    </div>
  </section>

  <!-- Second business line: IT services teaser -->
  <section class="section it-teaser">
    <div class="container it-teaser__inner">
      <div class="it-teaser__copy">
        <span class="eyebrow">{itServices.eyebrow}</span>
        <h2>{itServices.heading}</h2>
        <p class="lead">{itServices.tagline} — {itServices.description}</p>
        <div class="actions">
          <a class="btn btn--primary" href="/it-services">
            Explore IT services
            <Icon name="arrowRight" />
          </a>
        </div>
      </div>

      <ul class="it-teaser__list">
        {
          itServices.services.map((service) => (
            <li>
              <span class="icon-tile">
                <Icon name={service.icon as any} />
              </span>
              <span>{service.title}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Visit us -->
  <section class="section section--alt">
    <div class="container visit">
      <div class="visit__copy">
        <span class="eyebrow">Visit our shop</span>
        <h2>Come see us in person</h2>
        <p class="lead">
          No online cart and no delivery windows — walk in, pick what you need, and ask us anything. If
          something is not on the shelf, tell us and we will try to bring it in on the next stock run.
        </p>

        <div class="actions">
          <a class="btn btn--primary" href="/contact">
            Get in touch
            <Icon name="arrowRight" />
          </a>
          <a class="btn btn--outline" href="/about">About our shop</a>
        </div>
      </div>

      <figure class="visit__figure">
        <ShelfRack />
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .visit {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
  }

  .visit > * {
    min-width: 0;
  }

  @media (min-width: 58rem) {
    .visit {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .visit__figure {
    margin: 0;
    padding: clamp(0.75rem, 1.5vw, 1.15rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .visit__figure :global(.shelfrack) {
    border-radius: var(--radius);
    background: var(--bg);
  }

  /* Second business line teaser — indigo/cyan accents locally, so this one
     section reads as a distinct line of business without touching the
     retail site's shared amber theme anywhere else. */
  .it-teaser {
    --amber: #7c6cff;
    --amber-light: #9c8dff;
    --amber-deep: #5b48e0;
    --amber-soft: rgba(124, 108, 255, 0.14);
    --amber-edge: rgba(124, 108, 255, 0.36);
    --sage: #22d3ee;
    --clay: #ec4899;
  }

  .it-teaser__inner {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
  }

  .it-teaser__inner > * {
    min-width: 0;
  }

  @media (min-width: 58rem) {
    .it-teaser__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .it-teaser__list {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    list-style: none;
    padding: 0;
  }

  .it-teaser__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    backdrop-filter: blur(12px);
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .it-teaser__list .icon-tile {
    width: 2.15rem;
    height: 2.15rem;
    margin-bottom: 0;
    color: #f5f7fb;
    background: linear-gradient(135deg, var(--amber), var(--sage));
    border: none;
    flex-shrink: 0;
  }

  .it-teaser__list .icon-tile .icon {
    width: 1.15rem;
    height: 1.15rem;
  }
</style>
