---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CategoryCard from "../components/CategoryCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { site, isPlaceholder, displayValue } from "../config/site";

const featured = site.categories.slice(0, 4);
const teasers = site.testimonials.slice(0, 3);
const { address, hours, mapLink } = site.contact;
const mapHref = isPlaceholder(mapLink) ? null : mapLink;
---

<BaseLayout title={site.name}>
  <Hero />

  <!-- Featured categories -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">What we stock</span>
        <h2>Everyday essentials, all under one roof</h2>
        <p class="lead">
          From kitchen staples to festive gifting, we keep the goods local households reach for most —
          restocked regularly and priced fairly.
        </p>
      </div>

      <div class="grid grid--4">
        {featured.map((category) => <CategoryCard {...category} examples={[]} />)}
      </div>

      <div class="actions actions--center">
        <a class="btn btn--glass" href="/products">
          View all {site.categories.length} categories →
        </a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section section--glow">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Why choose us</span>
        <h2>A shop built on service, not scale</h2>
        <p class="lead">
          We are a neighbourhood retailer, and that shapes how we buy, price and stock everything on our
          shelves.
        </p>
      </div>

      <div class="grid grid--4">
        {site.whyChooseUs.map((feature) => <FeatureCard {...feature} />)}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Testimonials</span>
        <h2>What our customers say</h2>
        <p class="lead">
          Highlighted quotes are placeholders — replace them with real customer feedback in
          <code>src/config/site.ts</code>.
        </p>
      </div>

      <div class="grid grid--3">
        {teasers.map((testimonial) => <TestimonialCard {...testimonial} />)}
      </div>
    </div>
  </section>

  <!-- Visit us -->
  <section class="section">
    <div class="container">
      <div class="panel panel--accent visit">
        <div class="visit__copy">
          <span class="eyebrow">Visit our shop</span>
          <h2>Come see us in person</h2>
          <p class="lead">
            No online cart, no delivery windows — just walk in, pick what you need, and ask us anything.
          </p>

          <div class="actions">
            <a class="btn btn--primary" href="/contact">Contact &amp; directions</a>
            {
              mapHref && (
                <a class="btn btn--glass" href={mapHref} target="_blank" rel="noopener noreferrer">
                  Open in maps
                </a>
              )
            }
          </div>
        </div>

        <dl class="facts facts--stacked visit__facts">
          <div>
            <dt>Address</dt>
            <dd class={isPlaceholder(address) ? "todo" : undefined}>{displayValue(address)}</dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd class={isPlaceholder(hours) ? "todo" : undefined}>{displayValue(hours)}</dd>
          </div>
          <div>
            <dt>Ordering</dt>
            <dd>Walk-in counter service only</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .visit {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
  }

  /* See the `min-width: 0` note in global.css — long words must not widen the column. */
  .visit > * {
    min-width: 0;
  }

  @media (min-width: 58rem) {
    .visit {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .visit__copy .lead {
    max-width: 32rem;
  }

  .visit__facts {
    padding: clamp(1.1rem, 2vw, 1.5rem);
    background: rgba(8, 11, 17, 0.45);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
</style>
