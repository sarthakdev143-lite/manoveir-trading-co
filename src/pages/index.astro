---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CategoryCard from "../components/CategoryCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { site, isPlaceholder, displayValue } from "../config/site";

const featured = site.categories.slice(0, 4);
const teasers = site.testimonials.slice(0, 3);
const { address, hours, mapLink } = site.contact;
const mapHref = isPlaceholder(mapLink) ? null : mapLink;

// The ticker scrolls by exactly -50%, so the track must hold two identical
// halves. Each half repeats the short trust list twice to fill wide screens.
const tickerHalf = [...site.trustBar, ...site.trustBar];
const tickerItems = [...tickerHalf, ...tickerHalf];
---

<BaseLayout title={site.name}>
  <Hero />

  <!-- Trust ticker -->
  <section class="ticker" aria-label="What we stand for">
    <div class="ticker__track">
      {
        tickerItems.map((item, i) => (
          <span class="ticker__item" aria-hidden={i >= site.trustBar.length ? "true" : undefined}>
            {item}
          </span>
        ))
      }
    </div>
  </section>

  <!-- Featured categories -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">01 / What we stock</span>
          <h2>Everyday essentials, all under one roof</h2>
        </div>
        <p class="lead">
          From kitchen staples to festive gifting, we keep the goods local households reach for most —
          restocked regularly and priced fairly.
        </p>
      </div>

      <div class="matrix matrix--4">
        {
          featured.map((category, i) => (
            <CategoryCard {...category} examples={[]} index={i + 1} />
          ))
        }
      </div>

      <div class="actions">
        <a class="btn btn--primary" href="/products">
          View all {site.categories.length} categories
        </a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section section--paper2">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">02 / Why choose us</span>
          <h2>A shop built on service, not scale</h2>
        </div>
        <p class="lead">
          We are a neighbourhood retailer, and that shapes how we buy, price and stock everything on our
          shelves.
        </p>
      </div>

      <div class="matrix matrix--4">
        {site.whyChooseUs.map((feature, i) => <FeatureCard {...feature} index={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">03 / Testimonials</span>
          <h2>What our customers say</h2>
        </div>
        <p class="lead">
          Highlighted quotes are placeholders — replace them with real customer feedback in
          <code>src/config/site.ts</code>.
        </p>
      </div>

      <div class="matrix matrix--3">
        {teasers.map((testimonial, i) => <TestimonialCard {...testimonial} index={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- Visit us strip -->
  <section class="section section--ink">
    <div class="container visit">
      <div class="visit__copy">
        <span class="eyebrow">04 / Visit our shop</span>
        <h2>Come see us in person</h2>
        <p class="lead">
          No online cart, no delivery windows — just walk in, pick what you need, and ask us anything.
        </p>

        <div class="actions">
          <a class="btn btn--primary" href="/contact">Contact &amp; directions</a>
          {
            mapHref && (
              <a class="btn btn--onDark" href={mapHref} target="_blank" rel="noopener noreferrer">
                Open in maps
              </a>
            )
          }
        </div>
      </div>

      <dl class="meta meta--stacked visit__facts">
        <div>
          <dt>Address</dt>
          <dd class={isPlaceholder(address) ? "todo" : undefined}>{displayValue(address)}</dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd class={isPlaceholder(hours) ? "todo" : undefined}>{displayValue(hours)}</dd>
        </div>
        <div>
          <dt>Ordering</dt>
          <dd>Walk-in counter service only</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .visit {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 58rem) {
    .visit {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .visit__copy .lead {
    max-width: 34rem;
  }

  .visit__facts {
    margin-top: 0.5rem;
  }
</style>
