---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="About Us"
  description={`Learn about ${site.name} — a local retail shop stocking everyday consumer goods for neighbourhood families.`}
>
  <!-- Page header -->
  <section class="masthead">
    <div class="container masthead__inner">
      <div>
        <span class="eyebrow">About us</span>
        <h1>A neighbourhood shop, run the old-fashioned way</h1>
        <p class="lead">
          {site.name} exists to make everyday shopping simple: a dependable shelf, an honest price and someone
          behind the counter who knows what you came in for.
        </p>
      </div>

      <dl class="meta">
        <div>
          <dt>Section</dt>
          <dd>About</dd>
        </div>
        <div>
          <dt>Format</dt>
          <dd>Walk-in retail</dd>
        </div>
        <div>
          <dt>Categories</dt>
          <dd>{site.categories.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Our story -->
  <section class="section">
    <div class="container story">
      <div class="story__copy prose">
        <span class="eyebrow">01 / Our story</span>
        <h2>Built around what our neighbours actually need</h2>
        <p>
          {site.name} is a retail business engaged in the purchase and sale of various consumer goods and
          products. We buy carefully, stock deliberately and sell directly to the customers who walk through
          our door — no middlemen, no online cart, no delivery slots to wait on.
        </p>
        <p>
          Everything on our shelves is chosen the same way: by watching what local families come in asking for.
          Kitchen staples that run out weekly. Cleaning supplies nobody wants to make a special trip for.
          Stationery before the school term. Gifts and decorations when the festive season comes around. If
          enough people ask for something, it earns a place on the shelf.
        </p>
        <p>
          That is the whole idea — a single, reliable stop for the ordinary things, run by people you can
          actually talk to.
        </p>
      </div>

      <aside class="panel panel--lime story__aside">
        <h2 class="story__aside-title">At a glance</h2>
        <dl class="meta meta--stacked">
          <div>
            <dt>Business type</dt>
            <dd>Local shop-based retail — walk-in customers</dd>
          </div>
          <div>
            <dt>What we do</dt>
            <dd>Purchase and sale of consumer goods and products</dd>
          </div>
          <div>
            <dt>Who we serve</dt>
            <dd>Local households and neighbourhood families</dd>
          </div>
          <div>
            <dt>Categories</dt>
            <dd>{site.categories.length} broad ranges under one roof</dd>
          </div>
        </dl>
        <a class="btn btn--ink story__aside-cta" href="/products">Browse our categories</a>
      </aside>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--paper2">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">02 / Our promise</span>
          <h2>Three things we will not compromise on</h2>
        </div>
        <p class="lead">
          The shop runs on repeat custom, so every decision behind the counter is made with the next visit in
          mind.
        </p>
      </div>
      <div class="matrix matrix--3">
        {site.values.map((value, i) => <FeatureCard {...value} index={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section--ink">
    <div class="container">
      <div class="section-head section-head--split stats-head">
        <div>
          <span class="eyebrow">03 / By the numbers</span>
          <h2>The shape of our shop</h2>
        </div>
      </div>

      <dl class="matrix matrix--4">
        {
          site.stats.map((stat, i) => (
            <div class="stat">
              <dt class="stat__label">
                <span class="cell__index">{String(i + 1).padStart(2, "0")}</span>
                {stat.label}
              </dt>
              <dd class="stat__value numeral">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container cta">
      <h2>Come in and have a look</h2>
      <p class="lead">
        The quickest way to know what we carry is to visit. We are happy to point you to what you need.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/contact">Get in touch</a>
        <a class="btn btn--outline" href="/products">See products</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 58rem) {
    .story {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }

  .story__copy h2 {
    margin-bottom: 1.25rem;
  }

  .story__copy p {
    color: var(--muted);
  }

  .story__aside {
    position: sticky;
    top: 6rem;
  }

  .story__aside-title {
    margin-bottom: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  /* On the lime panel, `--muted` labels sit too close to the ground colour. */
  .story__aside .meta {
    border-top-color: var(--ink);
  }

  .story__aside .meta > div {
    border-bottom-color: rgba(19, 21, 20, 0.3);
  }

  .story__aside .meta dt {
    color: var(--ink-70);
  }

  .story__aside-cta {
    margin-top: 1.5rem;
  }

  .stats-head {
    border-bottom-color: rgba(237, 238, 233, 0.5);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .stat__label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(237, 238, 233, 0.7);
  }

  .stat__value {
    margin: auto 0 0;
    text-transform: uppercase;
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    color: var(--lime);
  }

  .cta {
    max-width: 44rem;
  }
</style>
