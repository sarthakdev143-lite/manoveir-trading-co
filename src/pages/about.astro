---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import TechDesk from "../components/illustrations/TechDesk.astro";
import { site } from "../config/site";
---
<BaseLayout
  title="About Us"
  description={`${site.name} — an IT services firm providing staffing, delivery, consulting and managed support.`}
>
  <!-- Page header -->
  <section class="masthead">
    <div class="container masthead__inner masthead__inner--split">
      <div>
        <span class="eyebrow">About us</span>
        <h1>A small IT services practice, run directly</h1>
        <p class="lead">
          {site.name} exists to make engineering capacity straightforward to add: the right people, on the right
          terms, integrated into your own team.
        </p>
      </div>

      <figure class="masthead__figure">
        <TechDesk />
      </figure>
    </div>
  </section>

  <!-- Our story -->
  <section class="section">
    <div class="container story">
      <div class="story__copy prose">
        <span class="eyebrow">Our story</span>
        <h2>Built around what client teams actually need</h2>
        <p>
          {site.name} is an IT services practice. We place skilled technology professionals with client teams
          and take on focused software, consulting and support engagements. The goal is simple: augment your
          delivery capacity without adding a separate silo.
        </p>
        <p>
          Everything we take on is scoped the same way — by understanding the role, the stack, the timeline and
          the way your team actually works. From there we put forward people who match the brief, not the
          first available profile, and stay involved for the life of the engagement.
        </p>
        <p>
          We work with a practical range of clients, from single roles to small dev teams that need to be
          stood up quickly. Where there is a fit on stack and expectations, we make it work.
        </p>
      </div>

      <aside class="panel story__aside">
        <h2 class="story__aside-title">At a glance</h2>
        <dl class="facts facts--stacked">
          <div>
            <dt>Business type</dt>
            <dd>IT services — staff augmentation and delivery</dd>
          </div>
          <div>
            <dt>What we do</dt>
            <dd>Staff augmentation, software delivery, consulting and managed support</dd>
          </div>
          <div>
            <dt>Who we serve</dt>
            <dd>Client product, engineering and operations teams</dd>
          </div>
          <div>
            <dt>Services</dt>
            <dd>{site.itServices.services.length} core service lines</dd>
          </div>
        </dl>
        <a class="btn btn--outline story__aside-cta" href="/it-services">
          See our services
          <Icon name="arrowRight" />
        </a>
      </aside>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our promise</span>
        <h2>Three things we will not compromise on</h2>
        <p class="lead">
          Engagements run on repeat trust, so every decision is made with the next one in mind.
        </p>
      </div>
      <div class="grid grid--3">
        {site.values.map((value) => <FeatureCard {...value} />)}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How we work</span>
        <h2>In short</h2>
      </div>

      <dl class="grid grid--4">
        {
          site.stats.map((stat) => (
            <div class="stat">
              <dt class="stat__value">{stat.value}</dt>
              <dd class="stat__label">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--alt">
    <div class="container section-head" style="margin-bottom:0">
      <h2>Talk to us about a role or a team</h2>
      <p class="lead">
        Send a short brief and we will come back with people who fit.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/contact">
          Get in touch
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--outline" href="/it-services">See services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead__figure {
    margin: 0;
    padding: clamp(0.65rem, 1.2vw, 1rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .masthead__figure :global(.techdesk) {
    border-radius: var(--radius);
    background: var(--bg);
  }

  .story {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .story > * {
    min-width: 0;
  }

  @media (min-width: 58rem) {
    .story {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }

  .story__copy h2 {
    margin-bottom: 1.15rem;
  }

  .story__aside {
    position: sticky;
    top: 6rem;
  }

  .story__aside-title {
    margin-bottom: 1rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .story__aside-cta {
    width: 100%;
    margin-top: 1.35rem;
  }
</style>
