---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import Counter from "../components/illustrations/Counter.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="About Us"
  description={`Learn about ${site.name} — a local retail shop stocking everyday consumer goods for neighbourhood families.`}
>
  <!-- Page header -->
  <section class="masthead">
    <div class="container masthead__inner masthead__inner--split">
      <div>
        <span class="eyebrow">About us</span>
        <h1>A neighbourhood shop, run the old-fashioned way</h1>
        <p class="lead">
          {site.name} exists to make everyday shopping simple: a dependable shelf, an honest price and someone
          behind the counter who knows what you came in for.
        </p>
      </div>

      <figure class="masthead__figure">
        <Counter />
      </figure>
    </div>
  </section>

  <!-- Our story -->
  <section class="section">
    <div class="container story">
      <div class="story__copy prose">
        <span class="eyebrow">Our story</span>
        <h2>Built around what our neighbours actually need</h2>
        <p>
          {site.name} is a retail business engaged in the purchase and sale of various consumer goods and
          products. We buy carefully, stock deliberately and sell directly to the customers who walk through
          our door — no middlemen, no online cart, no delivery slots to wait on.
        </p>
        <p>
          Everything on our shelves is chosen the same way: by watching what local families come in asking for.
          Kitchen staples that run out weekly. Cleaning supplies nobody wants to make a special trip for.
          Stationery before the school term. Gifts and decorations when the festive season comes around. If
          enough people ask for something, it earns a place on the shelf.
        </p>
        <p>
          That is the whole idea — a single, reliable stop for the ordinary things, run by people you can
          actually talk to.
        </p>
      </div>

      <aside class="panel story__aside">
        <h2 class="story__aside-title">At a glance</h2>
        <dl class="facts facts--stacked">
          <div>
            <dt>Business type</dt>
            <dd>Local shop-based retail — walk-in customers</dd>
          </div>
          <div>
            <dt>What we do</dt>
            <dd>Purchase and sale of consumer goods and products</dd>
          </div>
          <div>
            <dt>Who we serve</dt>
            <dd>Local households and neighbourhood families</dd>
          </div>
          <div>
            <dt>Categories</dt>
            <dd>{site.categories.length} broad ranges under one roof</dd>
          </div>
        </dl>
        <a class="btn btn--outline story__aside-cta" href="/products">
          Browse our categories
          <Icon name="arrowRight" />
        </a>
      </aside>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our promise</span>
        <h2>Three things we will not compromise on</h2>
        <p class="lead">
          The shop runs on repeat custom, so every decision behind the counter is made with the next visit in
          mind.
        </p>
      </div>
      <div class="grid grid--3">
        {site.values.map((value) => <FeatureCard {...value} />)}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The shape of our shop</span>
        <h2>How we work, in short</h2>
      </div>

      <dl class="grid grid--4">
        {
          site.stats.map((stat) => (
            <div class="stat">
              <dt class="stat__value">{stat.value}</dt>
              <dd class="stat__label">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--alt">
    <div class="container section-head" style="margin-bottom:0">
      <h2>Come in and have a look</h2>
      <p class="lead">
        The quickest way to know what we carry is to visit. We are happy to point you to what you need.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/contact">
          Get in touch
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--outline" href="/products">See products</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead__figure {
    margin: 0;
    padding: clamp(0.65rem, 1.2vw, 1rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .masthead__figure :global(.counter) {
    border-radius: var(--radius);
    background: var(--bg);
  }

  .story {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .story > * {
    min-width: 0;
  }

  @media (min-width: 58rem) {
    .story {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }

  .story__copy h2 {
    margin-bottom: 1.15rem;
  }

  .story__aside {
    position: sticky;
    top: 6rem;
  }

  .story__aside-title {
    margin-bottom: 1rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .story__aside-cta {
    width: 100%;
    margin-top: 1.35rem;
  }
</style>
