---
import { site } from "../config/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">M</span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__tagline">{site.tagline}</span>
      </span>
    </a>

    <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="Toggle navigation menu" />
    <label class="nav-toggle__label" for="nav-toggle" aria-controls="site-nav">
      <span class="nav-toggle__word" aria-hidden="true">Menu</span>
      <span class="visually-hidden">Toggle navigation menu</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </label>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <ul class="site-nav__list">
        {
          site.nav.map((item, i) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                <span class="site-nav__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary site-nav__cta" href="/contact">Visit Our Shop</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 0;
    padding-bottom: 0;
    color: inherit;
  }

  .brand:hover {
    background: transparent;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    background: var(--ink);
    color: var(--lime);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .brand:hover .brand__mark {
    background: var(--lime);
    color: var(--ink);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .brand__tagline {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .site-nav__list a {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border-bottom: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .site-nav__num {
    font-size: 0.62rem;
    color: var(--clay-ink);
  }

  .site-nav__list a:hover {
    background: var(--lime);
  }

  .site-nav__list a[aria-current="page"] {
    background: var(--ink);
    color: var(--paper);
  }

  .site-nav__list a[aria-current="page"] .site-nav__num {
    color: var(--lime);
  }

  /* CSS-only mobile menu: hidden checkbox drives the panel, zero client JS.
     The checkbox is visually hidden but remains focusable for keyboard users. */
  .nav-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .nav-toggle__label {
    display: none;
  }

  @media (max-width: 56rem) {
    .nav-toggle__label {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.5rem 0.75rem;
      border: 2px solid var(--ink);
      background: var(--surface);
      cursor: pointer;
    }

    .nav-toggle__word {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .nav-toggle__bars,
    .nav-toggle__bars::before,
    .nav-toggle__bars::after {
      content: "";
      display: block;
      width: 1.05rem;
      height: 2px;
      background: var(--ink);
    }

    .nav-toggle__bars::before {
      transform: translateY(-6px);
    }

    .nav-toggle__bars::after {
      transform: translateY(4px);
    }

    .nav-toggle:checked ~ .nav-toggle__label {
      background: var(--lime);
    }

    .nav-toggle:focus-visible ~ .nav-toggle__label {
      outline: 3px solid var(--clay);
      outline-offset: 2px;
    }

    .site-nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-inline: calc(var(--gutter) * -1);
      padding-bottom: 1.25rem;
      border-top: var(--line);
    }

    .nav-toggle:checked ~ .site-nav {
      display: flex;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav__list li {
      border-bottom: var(--line-soft);
    }

    .site-nav__list a {
      padding: 1rem var(--gutter);
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .site-nav__num {
      font-family: var(--font-mono);
      font-size: 0.7rem;
    }

    .site-nav__cta {
      margin: 1.25rem var(--gutter) 0;
    }
  }
</style>
