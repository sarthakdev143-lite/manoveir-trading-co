---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  desc: string;
  /** Icon name from src/components/Icon.astro. */
  icon: string;
  examples?: string[];
}

const { title, desc, icon, examples = [] } = Astro.props;
---

<article class="card category">
  <span class="icon-tile">
    <Icon name={icon as any} />
  </span>
  <h3>{title}</h3>
  <p>{desc}</p>
  {
    examples.length > 0 && (
      <ul class="category__list">
        {examples.map((item) => (
          <li>
            <Icon name="check" />
            {item}
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .category__list {
    margin-top: auto;
    padding: 0.9rem 0 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border-top: 1px solid var(--line);
  }

  .category__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--text-faint);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .category__list :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.3rem;
    color: var(--amber);
    opacity: 0.85;
  }
</style>
