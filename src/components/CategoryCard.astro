---
interface Props {
  title: string;
  desc: string;
  icon: string;
  examples?: string[];
  /** 1-based position in the grid, rendered as a mono index like "03". */
  index?: number;
}

const { title, desc, icon, examples = [], index } = Astro.props;
---

<article class="cell category">
  <div class="category__top">
    {index !== undefined && <span class="cell__index">{String(index).padStart(2, "0")}</span>}
    <span class="cell__icon" aria-hidden="true">{icon}</span>
  </div>
  <h3>{title}</h3>
  <p>{desc}</p>
  {
    examples.length > 0 && (
      <ul class="category__list">
        {examples.map((item) => <li>{item}</li>)}
      </ul>
    )
  }
</article>

<style>
  .category__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .category__list {
    margin-top: auto;
    padding: 0.4rem 0 0;
    list-style: none;
  }

  .category__list li {
    padding-block: 0.45rem;
    border-top: var(--line-soft);
    font-family: var(--font-mono);
    font-size: 0.73rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .cell:hover .category__list li {
    border-top-color: rgba(237, 238, 233, 0.22);
    color: rgba(237, 238, 233, 0.7);
  }
</style>
