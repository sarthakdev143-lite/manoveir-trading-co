---
import Icon from "./Icon.astro";
import TechDesk from "./illustrations/TechDesk.astro";
import { site } from "../config/site";
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="eyebrow">IT services · Staff augmentation</span>

      <h1>{site.name}</h1>
      <p class="hero__tagline">{site.tagline}</p>
      <p class="lead">{site.description}</p>

      <div class="actions">
        <a class="btn btn--primary" href="/it-services">
          Explore services
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--outline" href="/contact">Get in touch</a>
      </div>

      <ul class="trust hero__trust">
        {
          site.trustBar.map((item) => (
            <li>
              <Icon name="check" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__figure">
      <TechDesk />
      <figcaption>
        <Icon name="code" />
        Engineering capacity, matched to your stack and timeline
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.25rem, 5vw, 4rem);
    padding-bottom: clamp(2.75rem, 5.5vw, 4.5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
    align-items: center;
  }

  .hero__grid > * {
    min-width: 0;
  }

  @media (min-width: 62rem) {
    .hero__grid {
      grid-template-columns: 1fr 1.05fr;
    }
  }

  .hero__copy {
    max-width: 34rem;
  }

  .hero__tagline {
    margin-top: 0.7rem;
    color: var(--amber);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .hero__trust {
    margin-top: 1.85rem;
  }

  .hero__figure {
    margin: 0;
    padding: clamp(0.75rem, 1.5vw, 1.25rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .hero__figure :global(.techdesk) {
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .hero__figure figcaption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  .hero__figure figcaption :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--amber);
  }
</style>
