---
import { isPlaceholder, displayValue } from "../config/site";

interface Props {
  quote: string;
  name: string;
  detail: string;
  /** 1-based position in the grid, rendered as a mono index like "03". */
  index?: number;
}

const { quote, name, detail, index } = Astro.props;
---

<figure class="quote">
  <div class="quote__top">
    {index !== undefined && <span class="cell__index">{String(index).padStart(2, "0")}</span>}
    <span class="quote__mark" aria-hidden="true">&rdquo;</span>
  </div>

  <blockquote>{quote}</blockquote>

  <figcaption>
    <span class={`quote__name ${isPlaceholder(name) ? "todo" : ""}`.trim()}>
      {displayValue(name)}
    </span>
    <span class={`quote__detail ${isPlaceholder(detail) ? "todo" : ""}`.trim()}>
      {displayValue(detail)}
    </span>
  </figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2.2vw, 1.9rem);
  }

  .quote__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .quote__mark {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 0.5;
    color: var(--clay);
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .quote figcaption {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: var(--line);
  }

  .quote__name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .quote__detail {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
