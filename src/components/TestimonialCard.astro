---
import { isPlaceholder, displayValue } from "../config/site";

interface Props {
  quote: string;
  name: string;
  detail: string;
}

const { quote, name, detail } = Astro.props;

// First letter of the (possibly placeholder) name, for the avatar disc.
const initial = displayValue(name).trim().charAt(0).toUpperCase() || "•";
---

<figure class="card testimonial">
  <span class="testimonial__mark" aria-hidden="true">&ldquo;</span>
  <blockquote>{quote}</blockquote>

  <figcaption class="testimonial__by">
    <span class="testimonial__avatar" aria-hidden="true">{initial}</span>
    <span class="testimonial__who">
      <span class={`testimonial__name ${isPlaceholder(name) ? "todo" : ""}`.trim()}>
        {displayValue(name)}
      </span>
      <span class={`testimonial__detail ${isPlaceholder(detail) ? "todo" : ""}`.trim()}>
        {displayValue(detail)}
      </span>
    </span>
  </figcaption>
</figure>

<style>
  .testimonial {
    gap: 0.9rem;
  }

  .testimonial__mark {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 0.75;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .testimonial blockquote {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.65;
  }

  .testimonial__by {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .testimonial__avatar {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    background: var(--grad-soft);
    border: 1px solid rgba(124, 92, 255, 0.35);
    border-radius: 50%;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .testimonial__who {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-width: 0;
  }

  .testimonial__name {
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .testimonial__detail {
    color: var(--text-faint);
    font-size: 0.82rem;
  }
</style>
