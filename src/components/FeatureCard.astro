---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  desc: string;
  /** Icon name from src/components/Icon.astro. */
  icon: string;
}

const { title, desc, icon } = Astro.props;
---

<article class="card">
  <span class="icon-tile">
    <Icon name={icon as any} />
  </span>
  <h3>{title}</h3>
  <p>{desc}</p>
</article>
