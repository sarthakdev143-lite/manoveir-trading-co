---
/**
 * The site's icon set. Hand-drawn on a 24x24 grid with a 1.6 stroke, round
 * caps and joins, so every glyph sits on the same optical weight. Icons inherit
 * `currentColor` and scale with the `size` prop.
 *
 * Emoji are deliberately not used anywhere — they render differently per OS and
 * break the drawing style.
 *
 * Category and feature icons are referenced by name from src/config/site.ts.
 */

interface Props {
  name: keyof typeof paths;
  size?: number | string;
  /** Extra classes for positioning; colour comes from `currentColor`. */
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const paths = {
  // --- Product categories -------------------------------------------------
  /** Grain sack with a tied neck — groceries & staples. Reads far better at
      tile size than the wheat sprig it replaced. */
  grain: `<path d="M8.4 8.2h7.2c1.9 1.7 3 4.4 3 7.3 0 2.9-1.3 5-3.6 5H9c-2.3 0-3.6-2.1-3.6-5 0-2.9 1.1-5.6 3-7.3Z"/><path d="M8.4 8.2c-.6-1.1-.2-2.2 1-3.2 1 .9 2 1.4 2.6 1.4.6 0 1.6-.5 2.6-1.4 1.2 1 1.6 2.1 1 3.2"/><path d="M9 13.4c1.9 1.2 4.1 1.2 6 0"/>`,
  /** Spray bottle — household essentials. */
  spray: `<path d="M9 9h5.5a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-4.5a2 2 0 0 1-2-2v-9"/><path d="M10 9V6.5a1.5 1.5 0 0 1 1.5-1.5H13"/><path d="M9 9 6.5 7.2"/><path d="M20 5.5h-2.5"/><path d="M20 8h-2"/><path d="M19 3.2l-1.8 1"/><path d="M8.5 14h7.5"/>`,
  /** Pump bottle & droplet — personal care. */
  care: `<path d="M8.5 21h7a1.5 1.5 0 0 0 1.5-1.5v-7A2.5 2.5 0 0 0 14.5 10h-5A2.5 2.5 0 0 0 7 12.5v7A1.5 1.5 0 0 0 8.5 21Z"/><path d="M10 10V7.5h4V10"/><path d="M11 7.5V5.5A1.5 1.5 0 0 1 12.5 4h1"/><path d="M12 14c1 1.1 1.6 2 1.6 2.7a1.6 1.6 0 0 1-3.2 0C10.4 16 11 15.1 12 14Z"/>`,
  /** Cup with a straw — beverages & snacks. */
  cup: `<path d="M6.8 8.6h10.4l-.9 10.6a2 2 0 0 1-2 1.8H9.7a2 2 0 0 1-2-1.8Z"/><path d="M5.6 8.6h12.8"/><path d="M13.3 8.6 15.9 3.2"/><path d="M8 13.4h8"/>`,
  /** Pencil — stationery & sundries. */
  pencil: `<path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0 0-3l-1-1a2.1 2.1 0 0 0-3 0L4 16Z"/><path d="M13.5 6.5 17.5 10.5"/><path d="M4 16v4h4"/><path d="M6.2 13.8 10.2 17.8"/>`,
  /** Gift box — seasonal & festive goods. */
  gift: `<rect x="3.5" y="8.5" width="17" height="12" rx="1.6"/><path d="M3.5 12.5h17"/><path d="M12 8.5V21"/><path d="M12 8.5C10.6 8.5 7.5 8.3 7.5 6.2A2.2 2.2 0 0 1 12 5.8"/><path d="M12 8.5c1.4 0 4.5-.2 4.5-2.3A2.2 2.2 0 0 0 12 5.8"/>`,

  // --- Why choose us ------------------------------------------------------
  /** Shopping basket — wide selection. */
  basket: `<path d="M3.5 9.5h17l-1.4 9a2 2 0 0 1-2 1.7H6.9a2 2 0 0 1-2-1.7Z"/><path d="M8.5 9.5 11 4"/><path d="M15.5 9.5 13 4"/><path d="M9.5 13.5v3"/><path d="M14.5 13.5v3"/>`,
  /** Badge with a tick — quality assured. */
  verified: `<path d="M12 3.2l2.2 1.6 2.7-.2.9 2.6 2.2 1.6-1 2.6 1 2.6-2.2 1.6-.9 2.6-2.7-.2L12 20.8l-2.2-1.6-2.7.2-.9-2.6L4 15.2l1-2.6-1-2.6 2.2-1.6.9-2.6 2.7.2Z"/><path d="M9 12.2l2.2 2.2 3.9-4.3"/>`,
  /** Price tag — fair pricing. */
  tag: `<path d="M12.6 3.5H19a1.5 1.5 0 0 1 1.5 1.5v6.4a2 2 0 0 1-.6 1.4l-6.6 6.6a2 2 0 0 1-2.8 0l-5.4-5.4a2 2 0 0 1 0-2.8l6.6-6.6a2 2 0 0 1 1.4-.6Z"/><circle cx="16.2" cy="7.8" r="1.4"/>`,
  /** Two figures — friendly local service. */
  people: `<circle cx="9" cy="8" r="2.6"/><path d="M3.8 20v-1.4A4.1 4.1 0 0 1 7.9 14.5h2.2a4.1 4.1 0 0 1 4.1 4.1V20"/><path d="M16 6.1a2.6 2.6 0 0 1 0 5"/><path d="M17.4 14.6h.7a4.1 4.1 0 0 1 4.1 4.1V20"/>`,

  // --- Values -------------------------------------------------------------
  star: `<path d="M12 3.6l2.6 5.4 5.9.8-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.8l5.9-.8Z"/>`,
  /** Balance scales — honesty. */
  scales: `<path d="M12 4v16"/><path d="M8 20h8"/><path d="M5 7.5h14"/><path d="M12 4.2a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8Z"/><path d="M5 7.5 2.5 13a2.8 2.8 0 0 0 5 0Z"/><path d="M19 7.5 16.5 13a2.8 2.8 0 0 0 5 0Z"/>`,
  /** Row of houses — community. */
  neighbourhood: `<path d="M2.5 20V12l4.5-3.2L11.5 12v8"/><path d="M11.5 20v-6.5l5-3.5 5 3.5V20"/><path d="M1.5 20h21"/><path d="M6 20v-3.5h2V20"/><path d="M15.2 20v-3.2h2.6V20"/>`,

  // --- IT services ----------------------------------------------------------
  /** Angle brackets — software development. */
  code: `<path d="M9.5 8 4.5 12l5 4"/><path d="M14.5 8l5 4-5 4"/>`,
  /** Briefcase — IT consulting & advisory. */
  briefcase: `<rect x="3.5" y="8.5" width="17" height="11" rx="2"/><path d="M8.5 8.5V6.8A2.3 2.3 0 0 1 10.8 4.5h2.4a2.3 2.3 0 0 1 2.3 2.3v1.7"/><path d="M3.5 14h17"/>`,
  /** Shield with a tick — managed IT support. */
  shield: `<path d="M12 3.5l7 3v5.4c0 4.6-3 8.3-7 9.6-4-1.3-7-5-7-9.6V6.5Z"/><path d="M9 12.2l2.2 2.2 3.8-4.2"/>`,

  // --- Contact & UI -------------------------------------------------------
  phone: `<path d="M6.3 3.8h2.4l1.5 3.9-1.9 1.4a10.4 10.4 0 0 0 4.9 4.9l1.4-1.9 3.9 1.5v2.4a2.2 2.2 0 0 1-2.4 2.2A14.6 14.6 0 0 1 4.1 6.2a2.2 2.2 0 0 1 2.2-2.4Z"/>`,
  mail: `<rect x="2.8" y="5" width="18.4" height="14" rx="2"/><path d="M3.4 6.6 12 12.6l8.6-6"/>`,
  check: `<path d="M4.5 12.8l4.6 4.6L19.5 7"/>`,
  arrowRight: `<path d="M4.5 12h15"/><path d="M13.5 6l6 6-6 6"/>`,
  /** Shop awning — used as the brand glyph. */
  storefront: `<path d="M3.5 9.2h17V19a1.8 1.8 0 0 1-1.8 1.8H5.3A1.8 1.8 0 0 1 3.5 19Z"/><path d="M2.5 9.2 4.8 4h14.4l2.3 5.2"/><path d="M8.3 4 7.6 9.2"/><path d="M15.7 4l.7 5.2"/><path d="M9.4 20.8v-5.4h5.2v5.4"/>`,
} as const;

const d = paths[name];
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>

<style>
  .icon {
    display: block;
    flex-shrink: 0;
  }
</style>
