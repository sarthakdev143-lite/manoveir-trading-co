---
import { site, isPlaceholder, displayValue } from "../config/site";

const year = new Date().getFullYear();
const { address, phone, phoneDisplay, email, hours } = site.contact;
---

<footer class="site-footer">
  <div class="container">
    <!-- Oversized wordmark: the sign above the shop, set in type. -->
    <div class="site-footer__mark">
      <span class="site-footer__wordmark">{site.name}</span>
      <span class="site-footer__tagline">{site.tagline}</span>
    </div>
  </div>

  <div class="container site-footer__grid">
    <div class="site-footer__col site-footer__about">
      <h2 class="site-footer__heading">The Shop</h2>
      <p>{site.description}</p>
    </div>

    <nav class="site-footer__col" aria-label="Footer navigation">
      <h2 class="site-footer__heading">Explore</h2>
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Categories</h2>
      <ul>
        {site.categories.slice(0, 4).map((c) => <li><a href="/products">{c.title}</a></li>)}
        <li><a href="/products">All categories →</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Visit Us</h2>
      <dl class="site-footer__contact">
        <div>
          <dt>Address</dt>
          <dd class={isPlaceholder(address) ? "todo" : undefined}>{displayValue(address)}</dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd>
            {
              isPlaceholder(phone) ? (
                <span class="todo">{displayValue(phoneDisplay)}</span>
              ) : (
                <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}>{displayValue(phoneDisplay)}</a>
              )
            }
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd>
            {
              isPlaceholder(email) ? (
                <span class="todo">{displayValue(email)}</span>
              ) : (
                <a href={`mailto:${email}`}>{email}</a>
              )
            }
          </dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd class={isPlaceholder(hours) ? "todo" : undefined}>{displayValue(hours)}</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="container site-footer__bar">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="site-footer__note">
      Walk-in retail shop — no online ordering. · <a href="/privacy">Privacy</a> ·
      <a href="/sitemap-index.xml">Sitemap</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(237, 238, 233, 0.72);
    border-top: var(--line);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    font-size: 0.92rem;
  }

  .site-footer__mark {
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .site-footer__wordmark {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 5.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .site-footer__tagline {
    display: inline-block;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .site-footer__grid {
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    border-top: var(--line-dark);
  }

  /* Hairlines between columns, drawn as borders so they collapse cleanly
     when the grid reflows to a single column on narrow screens. */
  .site-footer__col {
    padding: 1.75rem 1.5rem 1.75rem 0;
    border-bottom: var(--line-dark);
  }

  @media (min-width: 60rem) {
    .site-footer__col + .site-footer__col {
      padding-left: 1.5rem;
      border-left: var(--line-dark);
    }
  }

  .site-footer__about p {
    max-width: 24rem;
    font-size: 0.9rem;
  }

  .site-footer__heading {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .site-footer ul li + li {
    margin-top: 0.5rem;
  }

  .site-footer a {
    color: rgba(237, 238, 233, 0.82);
    border-bottom: 0;
    padding-bottom: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-footer a:hover {
    background: var(--lime);
    color: var(--ink);
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .site-footer__contact dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(237, 238, 233, 0.45);
  }

  .site-footer__contact dd {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    color: rgba(237, 238, 233, 0.85);
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(237, 238, 233, 0.55);
  }

  .site-footer__note {
    color: rgba(237, 238, 233, 0.4);
  }
</style>
