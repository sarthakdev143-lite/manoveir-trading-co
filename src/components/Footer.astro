---
import Icon from "./Icon.astro";
import { site, isPlaceholder, displayValue } from "../config/site";

const year = new Date().getFullYear();
const { phone, phoneDisplay, email } = site.contact;
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/">
        <span class="site-footer__mark" aria-hidden="true">
          <Icon name="storefront" />
        </span>
        <span class="site-footer__name">{site.name}</span>
      </a>
      <p>{site.description}</p>
    </div>

    <nav class="site-footer__col" aria-label="Footer navigation">
      <h2 class="site-footer__heading">Explore</h2>
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Categories</h2>
      <ul>
        {site.categories.slice(0, 4).map((c) => <li><a href="/products">{c.title}</a></li>)}
        <li><a href="/products">All categories</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Get in touch</h2>
      <ul class="site-footer__contact">
        <li>
          <Icon name="phone" />
          {
            isPlaceholder(phone) ? (
              <span class="todo">{displayValue(phoneDisplay)}</span>
            ) : (
              <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}>{displayValue(phoneDisplay)}</a>
            )
          }
        </li>
        <li>
          <Icon name="mail" />
          {
            isPlaceholder(email) ? (
              <span class="todo">{displayValue(email)}</span>
            ) : (
              <a href={`mailto:${email}`}>{email}</a>
            )
          }
        </li>
        <li>
          <Icon name="storefront" />
          <span>Walk-in counter service</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bar">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="site-footer__note">
      <a href="/privacy">Privacy</a> · <a href="/sitemap-index.xml">Sitemap</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    font-size: 0.94rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    padding-bottom: 2.5rem;
  }

  .site-footer__grid > * {
    min-width: 0;
  }

  .site-footer__brand {
    max-width: 22rem;
  }

  .site-footer__brand p {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .site-footer__mark {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    color: var(--amber);
    background: var(--amber-soft);
    border: 1px solid var(--amber-edge);
    border-radius: var(--radius-sm);
  }

  .site-footer__mark :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .site-footer__heading {
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer a {
    color: var(--text-dim);
  }

  .site-footer a:hover {
    color: var(--amber);
  }

  .site-footer__contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    color: var(--text-dim);
    font-size: 0.88rem;
  }

  .site-footer__contact :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--amber);
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--text-faint);
    font-size: 0.85rem;
  }
</style>
