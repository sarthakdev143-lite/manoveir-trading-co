---
import { site, isPlaceholder, displayValue } from "../config/site";

const year = new Date().getFullYear();
const { address, phone, phoneDisplay, email, hours } = site.contact;
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/">
        <span class="site-footer__mark" aria-hidden="true">M</span>
        <span class="site-footer__name">{site.name}</span>
      </a>
      <p>{site.description}</p>
    </div>

    <nav class="site-footer__col" aria-label="Footer navigation">
      <h2 class="site-footer__heading">Explore</h2>
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Categories</h2>
      <ul>
        {site.categories.slice(0, 4).map((c) => <li><a href="/products">{c.title}</a></li>)}
        <li><a href="/products">All categories →</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Visit us</h2>
      <dl class="facts facts--stacked site-footer__contact">
        <div>
          <dt>Address</dt>
          <dd class={isPlaceholder(address) ? "todo" : undefined}>{displayValue(address)}</dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd>
            {
              isPlaceholder(phone) ? (
                <span class="todo">{displayValue(phoneDisplay)}</span>
              ) : (
                <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}>{displayValue(phoneDisplay)}</a>
              )
            }
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd>
            {
              isPlaceholder(email) ? (
                <span class="todo">{displayValue(email)}</span>
              ) : (
                <a href={`mailto:${email}`}>{email}</a>
              )
            }
          </dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd class={isPlaceholder(hours) ? "todo" : undefined}>{displayValue(hours)}</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="container site-footer__bar">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="site-footer__note">
      Walk-in retail shop — no online ordering. · <a href="/privacy">Privacy</a> ·
      <a href="/sitemap-index.xml">Sitemap</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--bg-3);
    border-top: 1px solid var(--line);
    padding-top: clamp(2.75rem, 5vw, 4rem);
    font-size: 0.94rem;
  }

  /* Gradient hairline along the very top edge. */
  .site-footer::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: -1px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(124, 92, 255, 0.55) 30%,
      rgba(34, 211, 238, 0.45) 70%,
      transparent
    );
  }

  .site-footer__grid {
    display: grid;
    gap: 2.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    padding-bottom: 2.5rem;
  }

  .site-footer__brand {
    max-width: 22rem;
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }

  .site-footer__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--grad);
    border-radius: 12px;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .site-footer__heading {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer a {
    color: var(--text-dim);
  }

  .site-footer a:hover {
    color: var(--violet-text);
  }

  .site-footer__contact dt {
    font-size: 0.74rem;
  }

  .site-footer__contact dd {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--line);
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  .site-footer__note {
    color: var(--text-faint);
  }
</style>
