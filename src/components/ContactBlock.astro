---
import Icon from "./Icon.astro";
import { site, isPlaceholder, displayValue } from "../config/site";

const { phone, phoneDisplay, email } = site.contact;

const hasPhone = !isPlaceholder(phone);
const hasEmail = !isPlaceholder(email);
const telHref = hasPhone ? `tel:${phone.replace(/[^+\d]/g, "")}` : null;
---

<ul class="details">
  <li>
    <span class="icon-tile icon-tile--lg">
      <Icon name="phone" />
    </span>
    <div class="details__body">
      <h3>Phone</h3>
      {
        telHref ? (
          <p><a class="details__link" href={telHref}>{displayValue(phoneDisplay)}</a></p>
        ) : (
          <p class="todo">{displayValue(phoneDisplay)}</p>
        )
      }
      <p class="details__note">
        {hasPhone
          ? "Call us for stock enquiries or bulk orders."
          : "Our published number is being finalised — please drop by the shop in the meantime."}
      </p>
    </div>
  </li>

  <li>
    <span class="icon-tile icon-tile--lg">
      <Icon name="mail" />
    </span>
    <div class="details__body">
      <h3>Email</h3>
      {
        hasEmail ? (
          <p><a class="details__link" href={`mailto:${email}`}>{email}</a></p>
        ) : (
          <p class="todo">{displayValue(email)}</p>
        )
      }
      <p class="details__note">
        {hasEmail
          ? "Written enquiries are usually answered the same day."
          : "Our enquiry inbox is being set up."}
      </p>
    </div>
  </li>
</ul>

<style>
  .details {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .details li {
    display: flex;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .details li:first-child {
    padding-top: 0;
  }

  .details li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .details .icon-tile {
    margin-bottom: 0;
  }

  .details__body {
    min-width: 0;
  }

  .details h3 {
    margin-bottom: 0.25rem;
    color: var(--text-faint);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .details__body > p {
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .details__link {
    color: var(--text);
  }

  .details__link:hover {
    color: var(--amber);
  }

  /* Outweighs `.details__body > p`, which carries the emphasised value. */
  .details__body > .details__note {
    margin-top: 0.3rem;
    color: var(--text-faint);
    font-size: 0.86rem;
    font-weight: 400;
  }
</style>
