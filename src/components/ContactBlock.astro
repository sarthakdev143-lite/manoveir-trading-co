---
import { site, isPlaceholder, displayValue } from "../config/site";

const { address, phone, phoneDisplay, email, hours, mapLink } = site.contact;

const telHref = isPlaceholder(phone) ? null : `tel:${phone.replace(/[^+\d]/g, "")}`;
const mailHref = isPlaceholder(email) ? null : `mailto:${email}`;
const mapHref = isPlaceholder(mapLink) ? null : mapLink;
---

<ul class="details">
  <li>
    <span class="details__num" aria-hidden="true">01</span>
    <div class="details__body">
      <h3>Shop Address</h3>
      <p class={isPlaceholder(address) ? "todo" : undefined}>{displayValue(address)}</p>
      {
        mapHref ? (
          <a class="details__link" href={mapHref} target="_blank" rel="noopener noreferrer">
            Open in Google Maps →
          </a>
        ) : (
          <p class="details__hint">
            Add <code>mapLink</code> in <code>src/config/site.ts</code> to enable directions.
          </p>
        )
      }
    </div>
  </li>

  <li>
    <span class="details__num" aria-hidden="true">02</span>
    <div class="details__body">
      <h3>Phone</h3>
      {
        telHref ? (
          <p><a class="details__link" href={telHref}>{displayValue(phoneDisplay)}</a></p>
        ) : (
          <p class="todo">{displayValue(phoneDisplay)}</p>
        )
      }
      <p class="details__hint">Call us for stock enquiries or bulk orders.</p>
    </div>
  </li>

  <li>
    <span class="details__num" aria-hidden="true">03</span>
    <div class="details__body">
      <h3>Email</h3>
      {
        mailHref ? (
          <p><a class="details__link" href={mailHref}>{email}</a></p>
        ) : (
          <p class="todo">{displayValue(email)}</p>
        )
      }
    </div>
  </li>

  <li>
    <span class="details__num" aria-hidden="true">04</span>
    <div class="details__body">
      <h3>Opening Hours</h3>
      <p class={isPlaceholder(hours) ? "todo" : undefined}>{displayValue(hours)}</p>
    </div>
  </li>
</ul>

<style>
  .details {
    list-style: none;
    padding: 0;
    border-top: var(--line);
  }

  .details li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0 1rem;
    padding-block: 1.15rem;
    border-bottom: var(--line);
  }

  .details__num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--clay-ink);
    padding-top: 0.2rem;
  }

  .details h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .details__body > p {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .details__link {
    border-bottom-width: 2px;
    font-weight: 700;
  }

  /* Outweighs `.details__body > p` above, which sets the large display type. */
  .details__body > .details__hint {
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }
</style>
