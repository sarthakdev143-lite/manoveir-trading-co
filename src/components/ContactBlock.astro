---
import { site, isPlaceholder, displayValue } from "../config/site";

const { address, phone, phoneDisplay, email, hours, mapLink } = site.contact;

const telHref = isPlaceholder(phone) ? null : `tel:${phone.replace(/[^+\d]/g, "")}`;
const mailHref = isPlaceholder(email) ? null : `mailto:${email}`;
const mapHref = isPlaceholder(mapLink) ? null : mapLink;
---

<ul class="details">
  <li>
    <span class="details__icon" aria-hidden="true">📍</span>
    <div class="details__body">
      <h3>Shop address</h3>
      <p class={isPlaceholder(address) ? "todo" : undefined}>{displayValue(address)}</p>
      {
        mapHref ? (
          <a class="details__link" href={mapHref} target="_blank" rel="noopener noreferrer">
            Open in Google Maps →
          </a>
        ) : (
          <p class="details__hint">
            Add <code>mapLink</code> in <code>src/config/site.ts</code> to enable directions.
          </p>
        )
      }
    </div>
  </li>

  <li>
    <span class="details__icon" aria-hidden="true">📞</span>
    <div class="details__body">
      <h3>Phone</h3>
      {
        telHref ? (
          <p><a class="details__link" href={telHref}>{displayValue(phoneDisplay)}</a></p>
        ) : (
          <p class="todo">{displayValue(phoneDisplay)}</p>
        )
      }
      <p class="details__hint">Call us for stock enquiries or bulk orders.</p>
    </div>
  </li>

  <li>
    <span class="details__icon" aria-hidden="true">✉️</span>
    <div class="details__body">
      <h3>Email</h3>
      {
        mailHref ? (
          <p><a class="details__link" href={mailHref}>{email}</a></p>
        ) : (
          <p class="todo">{displayValue(email)}</p>
        )
      }
    </div>
  </li>

  <li>
    <span class="details__icon" aria-hidden="true">🕐</span>
    <div class="details__body">
      <h3>Opening hours</h3>
      <p class={isPlaceholder(hours) ? "todo" : undefined}>{displayValue(hours)}</p>
    </div>
  </li>
</ul>

<style>
  .details {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .details li {
    display: flex;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .details li:first-child {
    padding-top: 0;
  }

  .details li:last-child {
    border-bottom: 0;
  }

  /* Flex item: must be allowed to shrink below the placeholder email's width. */
  .details__body {
    min-width: 0;
  }

  .details__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--grad-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 1.2rem;
    line-height: 1;
  }

  .details h3 {
    margin-bottom: 0.3rem;
    color: var(--text-faint);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .details__body > p {
    color: var(--text);
    font-size: 1.02rem;
    font-weight: 500;
    /* Email addresses have no break opportunities. */
    overflow-wrap: anywhere;
  }

  .details__link {
    color: var(--violet-text);
    font-weight: 500;
  }

  .details__link:hover {
    color: var(--cyan-text);
  }

  /* Outweighs `.details__body > p` above, which carries the emphasised value. */
  .details__body > .details__hint {
    margin-top: 0.35rem;
    color: var(--text-faint);
    font-size: 0.86rem;
    font-weight: 400;
  }
</style>
