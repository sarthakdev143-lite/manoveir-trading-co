---
/**
 * Flat-vector shop counter scene — weighing scale, filled paper bag and a
 * shelf of jars behind. Used on the About page. Same palette and drawing
 * style as Shopfront.astro.
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const WALL_DARK = "#221c15";
const FRAME = "#4c4133";
const AMBER = "#e8a33d";
const AMBER_DEEP = "#c8842a";
const CREAM = "#f3efe7";
const SAGE = "#7fa88a";
const CLAY = "#c96f4a";
---

<svg
  class:list={["counter", className]}
  viewBox="0 0 400 300"
  role="img"
  aria-label="Illustration of a shop counter: a weighing scale, a paper bag packed with groceries, and a shelf of jars on the wall behind"
>
  <!-- hanging lamp -->
  <path d="M200 8v22" stroke={FRAME} stroke-width="2" />
  <path d="M182 48c0-10 8-18 18-18s18 8 18 18Z" fill={AMBER_DEEP} />
  <ellipse cx="200" cy="49" rx="17" ry="3.5" fill={AMBER} />
  <path d="M200 52v10" stroke={AMBER} stroke-width="1.5" opacity="0.5" />

  <!-- wall shelf with jars -->
  <rect x="52" y="112" width="130" height="6" rx="2" fill={FRAME} />
  <rect x="62" y="84" width="20" height="28" rx="3" fill={AMBER} opacity="0.85" />
  <rect x="88" y="90" width="16" height="22" rx="3" fill={CREAM} opacity="0.75" />
  <rect x="110" y="80" width="18" height="32" rx="3" fill={SAGE} opacity="0.8" />
  <rect x="134" y="88" width="22" height="24" rx="3" fill={CLAY} opacity="0.8" />
  <rect x="162" y="84" width="14" height="28" rx="3" fill={CREAM} opacity="0.6" />

  <rect x="228" y="150" width="120" height="6" rx="2" fill={FRAME} />
  <rect x="238" y="124" width="18" height="26" rx="3" fill={CLAY} opacity="0.75" />
  <rect x="262" y="118" width="20" height="32" rx="3" fill={AMBER} opacity="0.7" />
  <rect x="288" y="126" width="16" height="24" rx="3" fill={SAGE} opacity="0.7" />
  <rect x="310" y="120" width="22" height="30" rx="3" fill={CREAM} opacity="0.55" />

  <!-- counter -->
  <rect x="34" y="188" width="332" height="18" rx="4" fill={FRAME} />
  <rect x="44" y="206" width="312" height="76" rx="3" fill={WALL_DARK} stroke={FRAME} stroke-width="2" />
  <path d="M148 206v76M252 206v76" stroke={FRAME} stroke-width="1.5" />
  <path d="M24 282h352" stroke={FRAME} stroke-width="3" stroke-linecap="round" />

  <!-- weighing scale -->
  <g>
    <rect x="86" y="170" width="56" height="10" rx="3" fill={FRAME} />
    <path d="M100 170v-8h28v8" fill="none" stroke={FRAME} stroke-width="2.5" />
    <circle cx="114" cy="146" r="17" fill={CREAM} opacity="0.92" />
    <circle cx="114" cy="146" r="17" fill="none" stroke={FRAME} stroke-width="2" />
    <path d="M114 146v-9" stroke={WALL_DARK} stroke-width="2" stroke-linecap="round" />
    <path d="M114 146l6 5" stroke={CLAY} stroke-width="2" stroke-linecap="round" />
    <rect x="92" y="128" width="44" height="6" rx="3" fill={AMBER} />
    <path d="M96 128c4-9 12-13 22-13s18 4 22 13Z" fill={SAGE} opacity="0.85" />
  </g>

  <!-- paper bag of groceries -->
  <g>
    <path d="M232 188h64l-6 -22h-52Z" fill={AMBER} opacity="0.9" />
    <path d="M226 188h76v-4a4 4 0 0 0-4-4h-68a4 4 0 0 0-4 4Z" fill={AMBER_DEEP} />
    <path d="M240 166c2-14 8-22 14-24-1 12-5 20-14 24Z" fill={SAGE} />
    <path d="M258 166c3-12 9-19 16-20-2 11-7 18-16 20Z" fill={SAGE} opacity="0.8" />
    <circle cx="282" cy="158" r="9" fill={CLAY} />
    <rect x="246" y="146" width="18" height="14" rx="2" fill={CREAM} opacity="0.85" />
  </g>

  <!-- ledger and pencil on the counter -->
  <g>
    <rect x="316" y="176" width="40" height="12" rx="2" fill={CREAM} opacity="0.8" />
    <path d="M316 182h40" stroke={FRAME} stroke-width="1.2" />
    <path d="M318 172l22-6 4 4-22 6Z" fill={AMBER} opacity="0.8" />
  </g>
</svg>

<style>
  .counter {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
