---
/**
 * Flat-vector shelving unit, used where a page needs a supporting image rather
 * than the full shopfront scene (the Products header, the About aside).
 * Same palette and drawing style as Shopfront.astro.
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const WALL_DARK = "#221c15";
const FRAME = "#4c4133";
const AMBER = "#e8a33d";
const AMBER_DEEP = "#c8842a";
const CREAM = "#f3efe7";
const SAGE = "#7fa88a";
const CLAY = "#c96f4a";
---

<svg
  class:list={["shelfrack", className]}
  viewBox="0 0 400 300"
  role="img"
  aria-label="Illustration of a stocked shop shelving unit: jars, packets, bottles and sacks arranged across three shelves, with a crate and hanging price tag"
>
  <!-- uprights -->
  <rect x="36" y="24" width="10" height="252" rx="3" fill={FRAME} />
  <rect x="354" y="24" width="10" height="252" rx="3" fill={FRAME} />
  <path d="M28 276h344" stroke={FRAME} stroke-width="3" stroke-linecap="round" />

  <!-- shelf one -->
  <g>
    <rect x="60" y="46" width="26" height="40" rx="3" fill={AMBER} />
    <rect x="60" y="46" width="26" height="9" rx="3" fill={AMBER_DEEP} />
    <rect x="94" y="56" width="22" height="30" rx="3" fill={CREAM} opacity="0.9" />
    <rect x="124" y="40" width="20" height="46" rx="4" fill={SAGE} />
    <rect x="152" y="52" width="28" height="34" rx="3" fill={CLAY} />
    <rect x="188" y="44" width="18" height="42" rx="3" fill={CREAM} opacity="0.75" />
    <rect x="214" y="58" width="30" height="28" rx="3" fill={AMBER} opacity="0.8" />
    <rect x="252" y="48" width="22" height="38" rx="3" fill={SAGE} opacity="0.75" />
    <rect x="282" y="54" width="26" height="32" rx="3" fill={CREAM} opacity="0.6" />
    <rect x="316" y="46" width="22" height="40" rx="3" fill={CLAY} opacity="0.7" />
  </g>
  <rect x="44" y="86" width="312" height="8" rx="2" fill={FRAME} />

  <!-- shelf two -->
  <g>
    <path d="M62 164c0-18 7-27 18-27s18 9 18 27Z" fill={AMBER} opacity="0.9" />
    <path d="M106 164c0-16 6-24 16-24s16 8 16 24Z" fill={CREAM} opacity="0.7" />
    <rect x="148" y="126" width="34" height="38" rx="3" fill={SAGE} />
    <path d="M148 138h34" stroke={WALL_DARK} stroke-width="2" opacity="0.5" />
    <rect x="192" y="132" width="28" height="32" rx="3" fill={CLAY} opacity="0.9" />
    <rect x="230" y="120" width="24" height="44" rx="10" fill={AMBER} opacity="0.75" />
    <rect x="262" y="130" width="30" height="34" rx="3" fill={CREAM} opacity="0.65" />
    <path d="M300 164c0-17 7-25 17-25s17 8 17 25Z" fill={SAGE} opacity="0.65" />
  </g>
  <rect x="44" y="164" width="312" height="8" rx="2" fill={FRAME} />

  <!-- shelf three -->
  <g>
    <rect x="60" y="212" width="40" height="30" rx="3" fill={CLAY} opacity="0.85" />
    <path d="M60 224h40" stroke={WALL_DARK} stroke-width="2" opacity="0.45" />
    <rect x="110" y="204" width="26" height="38" rx="3" fill={CREAM} opacity="0.8" />
    <rect x="146" y="214" width="34" height="28" rx="3" fill={AMBER} opacity="0.85" />
    <rect x="190" y="200" width="22" height="42" rx="3" fill={SAGE} opacity="0.8" />
    <rect x="222" y="210" width="36" height="32" rx="3" fill={CREAM} opacity="0.6" />
    <rect x="268" y="206" width="24" height="36" rx="3" fill={CLAY} opacity="0.7" />
    <rect x="302" y="216" width="32" height="26" rx="3" fill={AMBER} opacity="0.6" />
  </g>
  <rect x="44" y="242" width="312" height="8" rx="2" fill={FRAME} />

  <!-- crate on the floor -->
  <rect x="96" y="252" width="72" height="24" rx="3" fill={WALL_DARK} stroke={FRAME} stroke-width="2" />
  <path d="M96 264h72" stroke={FRAME} stroke-width="1.5" />

  <!-- hanging price tag -->
  <path d="M300 24v18" stroke={FRAME} stroke-width="2" />
  <path d="M292 42h30a4 4 0 0 1 4 4v14a4 4 0 0 1-4 4h-30l-8-11Z" fill={AMBER} />
  <circle cx="294" cy="53" r="2.6" fill={WALL_DARK} />
</svg>

<style>
  .shelfrack {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
