---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, isPlaceholder } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Set false on utility pages (e.g. 404) that should not be indexed. */
  indexable?: boolean;
}

const { title, description = site.description, indexable = true } = Astro.props;

// `Astro.site` comes from astro.config.mjs. It is always set in this project,
// but guard anyway so a missing config degrades to relative URLs rather than crashing.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

// Normalise canonical so /about and /about/ don't produce duplicate tags.
// Keep root as "/" and strip trailing slash elsewhere for SEO consistency.
const rawPath = Astro.url.pathname;
const normalisedPath = rawPath !== "/" && rawPath.endsWith("/") ? rawPath.slice(0, -1) : rawPath;
const canonical = abs(normalisedPath);
const ogImage = abs("/og-image.png");
const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;

const { phone, email, mapLink } = site.contact;
const { postalAddress, openingHoursSpec } = site;

// Structured data for local search (Google's map/hours panel). Every field is
// omitted unless it holds a real value — publishing placeholder contact details
// as machine-readable facts would be worse than publishing nothing.
const addressEntries = Object.entries(postalAddress).filter(([, v]) => !isPlaceholder(v));

const businessSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: site.name,
  description: site.description,
  url: abs("/"),
  image: ogImage,
  slogan: site.tagline,
  priceRange: "$$",
};

// `addressCountry` alone is not an address, so require at least a street or locality.
if (addressEntries.some(([k]) => k === "streetAddress" || k === "addressLocality")) {
  businessSchema.address = { "@type": "PostalAddress", ...Object.fromEntries(addressEntries) };
}
if (!isPlaceholder(phone)) businessSchema.telephone = phone;
if (!isPlaceholder(email)) businessSchema.email = email;
if (!isPlaceholder(mapLink)) businessSchema.hasMap = mapLink;
if (openingHoursSpec.length > 0) businessSchema.openingHours = openingHoursSpec;

// Only advertise the business to search engines once it has a real, contactable
// detail — otherwise the markup describes a shop nobody can reach.
const hasRealContactDetail = Boolean(
  businessSchema.address || businessSchema.telephone || businessSchema.email,
);
---

<!doctype html>
<html lang="en-IN" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f2040" />
    <meta name="author" content={site.name} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" href="/humans.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    {indexable ? (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    ) : (
      <meta name="robots" content="noindex, follow" />
    )}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    />

    {
      hasRealContactDetail && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(businessSchema)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
